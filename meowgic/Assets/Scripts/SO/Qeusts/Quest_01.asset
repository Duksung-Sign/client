%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d714834bf6cd0246b6e3e17e10e0596, type: 3}
  m_Name: Quest_01
  m_EditorClassIdentifier: 
  dialogueSets:
  - dialogueID: 111
    npcName: "\uD29C\uB098"
    dialogueLines:
    - text: "\uD734! \uB2F5\uB2F5\uD574 \uC8FD\uB294 \uC904 \uC54C\uC558\uB124!"
      isPlayer: 0
      customSpeakerName: 
    - text: '!'
      isPlayer: 1
      customSpeakerName: 
    - text: "\uC774\uAC8C \uBB34\uC2A8 \uC77C\uC774\uC9C0? \uCC38\uCE58\uCE94\uC774
        \uCC45\uC5D0\uC11C \uD280\uC5B4\uB098\uC654\uC5B4."
      isPlayer: 1
      customSpeakerName: 
    - text: "\uADF8\uB9AC\uACE0 \uB9D0\uC744 \uD558\uC796\uC544. \uB0B4\uAC00 \uAFC8\uC774\uB77C\uB3C4
        \uAFB8\uB294 \uAC78\uAE4C?"
      isPlayer: 1
      customSpeakerName: 
    - text: "\uC644\uC804 \uC544\uC2AC\uC544\uC2AC\uD588\uB124.\r\n\uC870\uAE08\uB9CC
        \uB354 \uB2A6\uC5C8\uC73C\uBA74 \uD070\uC77C\uB0A0 \uBED4 \uD588\uC5B4."
      isPlayer: 0
      customSpeakerName: 
    - text: "\uC18C\uAC1C\uAC00 \uB2A6\uC5C8\uC9C0? \uB09C \uD29C\uB098\uC57C."
      isPlayer: 0
      customSpeakerName: 
    - text: "\uC5EC\uAE30\uC11C \uC5BC\uB9C8\uB098 \uAE30\uB2E4\uB838\uB294\uC9C0
        \uBAB0\uB77C.\r\n\uB9D0 \uAC78\uC5B4\uB3C4 \uC544\uBB34 \uBC18\uC751\uB3C4
        \uC5C6\uACE0."
      isPlayer: 0
      customSpeakerName: 
    - text: "\uB0B4\uAC00 \uC9C4\uC9DC \uC560\uD0C0\uAC8C \uC18C\uB9AC \uC9C8\uB800\uB294\uB370
        \uC774\uBC88 \uAC83\uB3C4 \uBABB \uB4E3\uACE0 \uC9C0\uB098\uAC14\uC73C\uBA74
        \uC544\uC8FC\u2026"
      isPlayer: 0
      customSpeakerName: 
    - text: "\uD29C\uB098!"
      isPlayer: 1
      customSpeakerName: 
    - text: "\uC5D0\uD5F4, \uB2E4\uC2DC \uC18C\uAC1C\uD560\uAC8C. \uB09C \uBB18\uC5B4\uC758
        \uC218\uD638\uC790 \uD29C\uB098\uC57C."
      isPlayer: 0
      customSpeakerName: 
    - text: "\uBB18\uC5B4? \uADF8\uB7EC\uACE0 \uBCF4\uB2C8, \uC5B4\uB838\uC744 \uB54C
        \uCCB4\uB2E4\uC5D0\uAC8C \uB4E4\uC740 \uC801\uC774 \uC788\uC5B4.\r\n"
      isPlayer: 1
      customSpeakerName: 
    - text: "\uBB18\uC5B4\uB97C \uC4F8 \uC218\uB9CC \uC788\uB2E4\uBA74 \uBAA8\uB4E0
        \uAC78 \uC774\uB8F0 \uC218 \uC788\uB2E4\uACE0."
      isPlayer: 1
      customSpeakerName: 
    - text: "\uD558\uC9C0\uB9CC \uD5C8\uD669\uB41C \uC18C\uB9AC \uC544\uB2C8\uB0D0\uBA74\uC11C
        \uB118\uACBC\uB294\uB370\u2026"
      isPlayer: 1
      customSpeakerName: 
    - text: "\uD5C8\uD669\uB41C \uC18C\uB9AC\uB77C\uB2C8! \uBB18\uC5B4\uB294 \uC9C4\uC9DC\uC57C!"
      isPlayer: 0
      customSpeakerName: 
    - text: "\uB09C \uB9D0\uD55C \uC801\uC774 \uC5C6\uB294\uB370\u2026"
      isPlayer: 1
      customSpeakerName: 
    - text: "\uC77C\uB2E8 \uB098\uAC00\uC790! \uD55C\uC2DC\uAC00 \uAE09\uD574!"
      isPlayer: 0
      customSpeakerName: 
    - text: "\uC774\uB7F0, \uB2A6\uC5C8\uB2E4! \uBBF8\uC624, \uC900\uBE44\uD574!"
      isPlayer: 0
      customSpeakerName: 
    isRepeatable: 0
